# Build artifacts
*.o
*.kpm

# Compiled Android arm64 binaries (built by build_shctl.ps1 / NDK clang)
/cli/shctl
/tools/hbtarget
/tools/mttarget

# Device-side scratch
*.out

# External dependency: KernelPatch is a git submodule at vendor/KernelPatch,
# pinned to upstream tag 0.13.2. After cloning: git submodule update --init --recursive.
# Ignore any other vendor/ scratch but keep the submodule tracked.
/vendor/*
!/vendor/KernelPatch/

# device-deploy artifacts (contain the APatch superkey -- never commit)
_kpmboot/
kpm_bootstrap.zip

# large extracted libs / scratch db (kpm symbol tooling)
/kpm/*.so
/kpm/mc.db
# compiled android tools (NDK clang outputs)
/tools/demohook
/tools/kpmhooktool
/tools/libartcensus
/tools/rgntool
/tools/ssoltarget

# 内部工程约定/指引，不入库（本地保留，供 Claude Code 读）
CLAUDE.md
